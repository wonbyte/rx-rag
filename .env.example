# Copy to .env and fill in. Endpoints are not secrets, but .env stays out
# of git because the values are yours.
# "__" means a nested config section: RxRag__TopK = { "RxRag": { "TopK": ... } }.
RxRag__OpenAIEndpoint=https://<your-openai-name>.openai.azure.com/
RxRag__ChatDeployment=chat
RxRag__EmbeddingDeployment=embed
RxRag__SearchEndpoint=https://<your-search-name>.search.windows.net
